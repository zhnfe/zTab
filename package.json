{
    "name": "zTab",
    "type": "module",
    "version": "1.0.3",
    "private": true,
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "type-check": "vue-tsc -b",
        "lint": "eslint --fix",
        "lint-only": "eslint --quiet",
        "postinstall": "simple-git-hooks"
    },
    "dependencies": {
        "@material-symbols/svg-400": "^0.36.4",
        "vue": "^3.5.30"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^7.7.3",
        "@crxjs/vite-plugin": "^2.4.0",
        "@tailwindcss/vite": "^4.2.2",
        "@tsconfig/node24": "^24.0.4",
        "@types/chrome": "^0.1.38",
        "@types/node": "^24.12.0",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vitejs/plugin-vue-jsx": "^5.1.5",
        "@vue/tsconfig": "^0.8.1",
        "daisyui": "^5.5.19",
        "eslint": "^9.39.4",
        "eslint-plugin-format": "^2.0.1",
        "simple-git-hooks": "^2.13.1",
        "tailwindcss": "^4.2.2",
        "typescript": "~5.9.3",
        "unplugin-vue-components": "^29.2.0",
        "vite": "^8.0.1",
        "vite-plugin-zip-pack": "^1.2.4",
        "vue-tsc": "^3.2.6"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run type-check && npm run lint"
    }
}
